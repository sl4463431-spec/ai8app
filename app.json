
{
  "expo": {
    "name": "AI8",
    "slug": "ai8app",
    "owner": "sadai8s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "ai8app",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080D24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sadai8s.ai8app"
    },
    "android": {
      "package": "com.sadai8s.ai8app",
      "adaptiveIcon": {
        "backgroundColor": "#080D24"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "PUT_REAL_PROJECT_ID_HERE"
      }
    }
  }
}

